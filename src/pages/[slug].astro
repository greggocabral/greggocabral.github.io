---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { formatDate, getPosts, type Post } from '../lib/posts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, date, category, subCategory } = post.data;
const { Content } = await render(post);
---

<Base title={`${title} | Gregorio Cabral`} description={description}>
  <main class="post">
    <header class="post-header">
      <p class="breadcrumb">{category} › {subCategory}</p>
      <h1 class="post-title">{title}</h1>
      <p class="byline">
        <a href="/">Gregorio Cabral</a>{' '}·{' '}
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
      </p>
    </header>
    <article class="prose">
      <Content />
    </article>
    <footer class="post-footer">
      <a href="/">← Home</a>
    </footer>
  </main>
</Base>
