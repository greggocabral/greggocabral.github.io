---
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects } from '../../lib/projects';

const projects = await getProjects();
---

<Base
  title="Projects | Gregorio Cabral"
  description="Projects Gregorio Cabral is currently building, including Alquilonido and Almanaque Digital."
>
  <main class="post projects">
    <header class="post-header">
      <p class="breadcrumb"><a href="/">Home</a></p>
      <h1 class="post-title">Projects</h1>
      <p class="byline">A few products I'm building right now.</p>
    </header>
    {projects.map((project) => (
      <ProjectCard project={project} />
    ))}
    <footer class="post-footer">
      <a href="/">← Home</a>
    </footer>
  </main>
</Base>

<style>
  .projects {
    max-width: 46rem;
  }

  .breadcrumb a {
    color: inherit;
    font-weight: 600;
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--accent);
  }

  .projects :global(.card + .card) {
    margin-top: 4rem;
    padding-top: 3.5rem;
    border-top: 1px solid var(--rule);
  }
</style>
