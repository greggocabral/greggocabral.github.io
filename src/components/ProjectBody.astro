---
import { render, type CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
  /** Heading level for the field labels. 3 when the page already uses h2 for the title. */
  depth?: 2 | 3;
}

const { project, depth = 2 } = Astro.props;
const { Content } = await render(project);
const { audience, problem, features, stack, url, repo } = project.data;
const H = depth === 3 ? 'h3' : 'h2';
---

<div class="prose">
  {(url || repo) && (
    <p class="project-links">
      {url && (
        <a href={url} target="_blank" rel="noopener">Open the app</a>
      )}
      {url && repo ? ' · ' : ''}
      {repo && (
        <a href={repo} target="_blank" rel="noopener">Source</a>
      )}
    </p>
  )}
  <H>What it is</H>
  <Content />
  <H>Who it's for</H>
  <p>{audience}</p>
  <H>The problem</H>
  <p>{problem}</p>
  <H>Features</H>
  <ul>
    {features.map((feature) => (
      <li>{feature}</li>
    ))}
  </ul>
  <H>Stack</H>
  <ul>
    {stack.map((item) => (
      <li>{item}</li>
    ))}
  </ul>
</div>

<style>
  .project-links {
    font-weight: 600;
  }

  .project-links a {
    text-decoration: none;
  }

  .project-links a:hover {
    text-decoration: underline;
  }
</style>
